      "end_ms": 89730,
      "speaker": "2",
      "token_start_index": 478,
      "token_end_index": 490
    },
    {
      "text": " That's what I understood.",
      "start_ms": 89970,
      "end_ms": 90750,
      "speaker": "1",
      "token_start_index": 490,
      "token_end_index": 499
    },
    {
      "text": " Oh, it's Thursday.",
      "start_ms": 91110,
      "end_ms": 91530,
      "speaker": "2",
      "token_start_index": 499,
      "token_end_index": 507
    },
    {
      "text": " 24th, I think.",
