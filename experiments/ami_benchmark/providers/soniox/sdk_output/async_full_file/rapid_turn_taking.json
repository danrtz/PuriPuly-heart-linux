      "end_ms": 77730,
      "speaker": "2",
      "token_start_index": 430,
      "token_end_index": 432
    },
    {
      "text": " Do we have to have done the evaluation by then?",
      "start_ms": 77910,
      "end_ms": 80310,
      "speaker": "1",
      "token_start_index": 432,
      "token_end_index": 447
    },
    {
      "text": " Yeah.",
