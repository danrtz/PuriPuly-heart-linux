      "end_ms": 93150,
      "speaker": "2",
      "token_start_index": 515,
      "token_end_index": 517
    },
    {
      "text": " So it's not the—",
      "start_ms": 93150,
      "end_ms": 93750,
      "speaker": "1",
      "token_start_index": 517,
      "token_end_index": 523
    },
    {
